    "version": "0.2.0",
    "configurations": [

        {
            "type": "java",
            "name": "Current File",
            "request": "launch",
            "mainClass": "${file}"
        },
        {
            "type": "java",
            "name": "ShubhInviteApplication (local profile)",
            "request": "launch",
            "mainClass": "com.shubhinvite.ShubhInviteApplication",
            "projectName": "shubhinvite-backend",
            "args": "--spring.profiles.active=local"
        },
        {
            "type": "java",
            "name": "ShubhInviteApplication (default profile / env vars)",
            "request": "launch",
            "mainClass": "com.shubhinvite.ShubhInviteApplication",
            "projectName": "shubhinvite-backend",
            "env": {
                "DATABASE_URL": "jdbc:postgresql://localhost:5432/shubhinvite",
                "DATABASE_USERNAME": "postgres",
                "DATABASE_PASSWORD": "root",
                "JWT_SECRET": "local-development-only-secret-do-not-use-in-production-1234567890",
                "JWT_EXPIRATION": "86400000",
                "CORS_ALLOWED_ORIGINS": "http://localhost:3000"
            }
        }
    ]
}